{
	"name": "sokos-astro-template",
	"type": "module",
	"version": "1.0.0",
	"scripts": {
		"astro": "astro",
		"dev": "astro dev",
		"dev:mock": "concurrently \"pnpm dev\" \"tsx mock/server.ts\"",
		"build": "astro check && astro build",
		"biome:check": "biome check --files-ignore-unknown=true",
		"biome:fix": "biome check --write --no-errors-on-unmatched",
		"prettier:format": "prettier --write '**/*.astro'",
		"stylelint:check": "stylelint '**/*.css'",
		"stylelint:fix": "stylelint '**/*.css' --fix",
		"prepare": "husky",
		"pnpm:resolve": "node scripts/resolve-pnpm-version.mjs"
	},
	"dependencies": {
		"@astrojs/check": "0.9.12",
		"@astrojs/node": "11.1.12",
		"@astrojs/react": "7.1.2",
		"@navikt/aksel-icons": "8.21.0",
		"@navikt/ds-css": "8.21.0",
		"@navikt/ds-react": "8.21.0",
		"@navikt/oasis": "4.2.2",
		"astro": "7.4.5",
		"pino-http": "11.0.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"rollup-plugin-import-map": "3.0.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@hono/node-server": "2.1.6",
		"@navikt/aksel-stylelint": "8.21.0",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"concurrently": "10.0.6",
		"hono": "4.13.16",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"postcss": "8.5.32",
		"postcss-prefix-selector": "2.2.1",
		"prettier": "3.9.10",
		"prettier-plugin-astro": "1.1.2",
		"stylelint": "17.16.0",
		"stylelint-config-standard": "40.0.0",
		"tsx": "4.23.15",
		"typescript": "6.0.3"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched",
		"*.astro": "prettier --write",
		"*.css": "stylelint --fix"
	},
	"engines": {
		"pnpm": ">=11.28.10",
		"node": ">=24.14.1"
	},
	"packageManager": "pnpm@11.28.10+sha512.672216f06e15c109b85471d49d3fbed17e6f03ead258df08c2bf5b4a5c33321ebfbf59476bce81325efada16ace0ac78548fd0bfcd7a51369e939182a3dd50e4"
}
