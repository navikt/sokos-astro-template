{
	"name": "sokos-astro-template",
	"type": "module",
	"version": "1.0.0",
	"scripts": {
		"astro": "astro",
		"dev": "astro dev",
		"dev:mock": "concurrently \"pnpm dev\" \"tsx mock/server.ts\"",
		"build": "astro check && astro build",
		"biome:check": "biome check --files-ignore-unknown=true",
		"biome:fix": "biome check --write --no-errors-on-unmatched",
		"prettier:format": "prettier --write '**/*.astro'",
		"stylelint:check": "stylelint '**/*.css'",
		"stylelint:fix": "stylelint '**/*.css' --fix",
		"prepare": "husky",
		"pnpm:resolve": "node scripts/resolve-pnpm-version.mjs"
	},
	"dependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/node": "11.1.6",
		"@astrojs/react": "6.0.6",
		"@navikt/aksel-icons": "8.15.0",
		"@navikt/ds-css": "8.15.0",
		"@navikt/ds-react": "8.15.0",
		"@navikt/oasis": "4.2.2",
		"astro": "7.3.3",
		"pino-http": "11.0.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"rollup-plugin-import-map": "3.0.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@hono/node-server": "2.1.5",
		"@navikt/aksel-stylelint": "7.37.0",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"concurrently": "10.0.6",
		"hono": "4.13.13",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"postcss": "8.5.31",
		"postcss-prefix-selector": "2.2.1",
		"prettier": "3.9.10",
		"prettier-plugin-astro": "1.1.1",
		"stylelint": "17.16.0",
		"stylelint-config-standard": "40.0.0",
		"tsx": "4.23.15",
		"typescript": "6.0.3"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched",
		"*.astro": "prettier --write",
		"*.css": "stylelint --fix"
	},
	"engines": {
		"pnpm": ">=11.28.6",
		"node": ">=24.14.1"
	},
	"packageManager": "pnpm@11.28.6+sha512.55d90390c3b39042f1505a2697789f0256c6d95bb28bdd7cb731af1887c9f2629ef581acb9f4e4ec772024c8203c2aed22a03299b97103fdcf32668e905d0024"
}
