{
	"name": "sokos-astro-template",
	"type": "module",
	"version": "1.0.0",
	"scripts": {
		"astro": "astro",
		"dev": "astro dev",
		"dev:mock": "concurrently \"pnpm dev\" \"tsx mock/server.ts\"",
		"build": "astro check && astro build",
		"biome:check": "biome check --files-ignore-unknown=true",
		"biome:fix": "biome check --write --no-errors-on-unmatched",
		"prettier:format": "prettier --write '**/*.astro'",
		"stylelint:check": "stylelint '**/*.css'",
		"stylelint:fix": "stylelint '**/*.css' --fix",
		"prepare": "husky",
		"pnpm:resolve": "node scripts/resolve-pnpm-version.mjs"
	},
	"dependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/node": "11.1.5",
		"@astrojs/react": "6.0.5",
		"@navikt/aksel-icons": "8.15.0",
		"@navikt/ds-css": "8.15.0",
		"@navikt/ds-react": "8.15.0",
		"@navikt/oasis": "4.2.2",
		"astro": "7.3.2",
		"pino-http": "11.0.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"rollup-plugin-import-map": "3.0.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@hono/node-server": "2.1.1",
		"@navikt/aksel-stylelint": "7.37.0",
		"@types/node": "26.4.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"concurrently": "10.0.5",
		"hono": "4.13.8",
		"husky": "9.1.7",
		"lint-staged": "17.5.1",
		"postcss": "8.5.28",
		"postcss-prefix-selector": "2.2.1",
		"prettier": "3.9.7",
		"prettier-plugin-astro": "1.0.1",
		"stylelint": "17.15.0",
		"stylelint-config-standard": "40.0.0",
		"tsx": "4.23.13",
		"typescript": "6.0.3"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched",
		"*.astro": "prettier --write",
		"*.css": "stylelint --fix"
	},
	"engines": {
		"pnpm": ">=11.27.0",
		"node": ">=24.14.1"
	},
	"packageManager": "pnpm@11.27.0+sha512.ad12821463bb143295f1fa3ecde77a6b9b97a7990386da800ff57bffc3964dc64b7b1c7559d5dbe5c337aea659ed9c8937d4370bd198ca2009bc6fa0249808e7"
}
